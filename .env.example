# Local development only. Copy to .env and replace local values if needed.
APP_ENV=local
API_ENV_MODE=SANDBOX_MOCK
SIMULATED_DATE_OFFSET_DAYS=0

# PostgreSQL (local Docker Compose)
POSTGRES_DB=secure_stack
POSTGRES_USER=secure_stack_app
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/secure_stack

# Object storage: local MinIO by default; use S3 adapter in AWS
OBJECT_STORAGE_MODE=minio
S3_BUCKET=secure-stack-documents-local
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_local_only_change_me

# Async queue / broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Internal processing-service URL
PROCESSING_SERVICE_BASE_URL=http://localhost:8001
PROCESSING_SERVICE_API_KEY=local_internal_only_change_me

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Provider integrations: leave blank until documented, authorized and implemented.
SETU_AA_BASE_URL=
SETU_AA_CLIENT_ID=
SETU_AA_CLIENT_SECRET=
BANK_VERIFICATION_BASE_URL=
BANK_VERIFICATION_CLIENT_ID=
BANK_VERIFICATION_CLIENT_SECRET=
AICTE_INTERNAL_ERP_BASE_URL=
AICTE_INTERNAL_ERP_API_KEY=
PFMS_BASE_URL=
PFMS_API_KEY=
ESIGN_PROVIDER_BASE_URL=
ESIGN_PROVIDER_API_KEY=

# AWS production values must be supplied through AWS IAM / Secrets Manager,
# not committed in .env files.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
